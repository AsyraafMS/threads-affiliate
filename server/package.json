{
  "name": "@threads-affiliate/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "dev:worker": "node --watch --env-file-if-exists=../.env src/worker.ts",
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.1"
  }
}
