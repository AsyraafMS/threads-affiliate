# Copy to .env. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Used when running server/worker on the host (npm run dev). docker-compose overrides these with service hostnames.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/threads_affiliate
REDIS_URL=redis://localhost:6379

# Only read by docker-compose for the postgres container.
POSTGRES_PASSWORD=postgres

# Host port docker-compose publishes the API on (container always listens on 3000).
HOST_PORT=3000
